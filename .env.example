# Flow Desktop Music Player - Server Environment Configuration
# Copy this file to .env.local and populate with your own developer API keys

# Server Configuration
PORT=8901
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Database Configuration
DATABASE_PATH=./data/flow.db

# Spotify Developer API (For playlist migration & external OAuth - Fix #903)
# Create your own project at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8901/api/auth/callback/spotify

# Google / YouTube Music OAuth (Optional for personal library sync)
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8901/api/auth/callback/google

# Last.fm Scrobbler API (For scrobbling play history)
# Obtain key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Discord Application Client ID (For Discord Rich Presence live playback status)
# Configure at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=

# Audio Cache & Download Storage Directory
CACHE_DIR=./data/cache
MAX_CACHE_SIZE_MB=1024
